generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int        @id @default(autoincrement())
  username          String     @unique
  firstName         String?    @map("first_name")
  lastName          String?    @map("last_name")
  password          String
  email             String     @unique
  passwordResetCode String?    @map("password_reset_code")
  status            UserStatus @default(PENDING)
  emailVerified     Boolean    @default(false) @map("email_verified")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  profilePicture    String?
  role              Role       @default(USER)
  phoneNumber       String?    @map("phone_number")
  balance           Int        @default(0)
  watchList         Auction[]
  sessions          Session[]
  seller            Seller?
  buyer             Buyer?
  bids              Bid[]
  autoBids          AutoBid[]
}

enum UserStatus {
  PENDING
  VERIFIED
  REJECTED
  BANNED
}

enum Role {
  ADMIN
  MODERATOR
  USER
  SUPER_ADMIN
}

model Seller {
  id          Int     @id @default(autoincrement())
  address     Address @relation(fields: [addressId], references: [id])
  userId      Int     @unique @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Float   @default(0)
  description String?
  addressId   Int     @unique
}

model Address {
  id        Int     @id @default(autoincrement())
  country   String
  region    String
  city      String
  street    String
  number    String
  building  String?
  floor     String?
  apartment String?
  zipCode   String  @map("zip_code")
  buyer     Buyer?
  seller    Seller?
}

model Buyer {
  id                Int     @id @default(autoincrement())
  userId            Int     @unique @map("user_id")
  shippingAddress   Address @relation(fields: [shippingAddressId], references: [id])
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingAddressId Int     @unique
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
}

enum AuctionType {
  ENGLISH
  DUTCH
  VICKREY
  FPSB
  JAPANESE
}

enum AuctionStatus {
  PENDING
  UPCOMING
  ACTIVE
  ENDED
  CANCELLED
}

model Auction {
  id          Int           @id @default(autoincrement())
  user        User?         @relation(fields: [userId], references: [id])
  userId      Int?
  status      AuctionStatus @default(PENDING)
  auctionType AuctionType   @default(ENGLISH) @map("auction_type")

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")

  reservePrice  Int? @map("reserve_price")
  currentPrice  Int
  startingPrice Int  @default(0) @map("starting_price")

  buyingPrice Int? @map("buying_price")

  title       String
  description String @db.Text

  tickInterval    Int?       @map("tick_interval")
  moneyInterval   Int?       @map("money_interval")
  minBidIncrement Int?       @default(1) @map("min_bid_increment")
  isAscending     Boolean?   @map("is_ascending")
  bids            Bid[]
  autoBids        AutoBid[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  watchItem       WatchItem?
  trendings       Trendings?
}

model Bid {
  id        Int      @id @default(autoincrement())
  bidTime   DateTime @default(now()) @map("bid_time")
  bidAmount Int      @map("bid_amount")
  isWinner  Boolean  @default(false) @map("is_winner")
  userId    Int
  auctionId Int
  autoBidId Int?
  user      User     @relation(fields: [userId], references: [id])
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  autoBid   AutoBid? @relation(fields: [autoBidId], references: [id], onDelete: SetNull)
}

model AutoBid {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidTime   DateTime @default(now()) @map("bid_time")
  maxAmount Int      @map("max_amount")
  increment Int
  userId    Int
  auctionId Int
  bids      Bid[]

  @@unique([userId, auctionId])
}

enum WatchCategory {
  WRISTWATCH
  POCKETWATCH
  SMARTWATCH
  CLOCK
}

model WatchItem {
  id             Int     @id @default(autoincrement())
  brand          String
  model          String
  productionYear Int?    @map("production_year")
  material       String
  condition      String
  weight         Float?
  hasBox         Boolean @default(false) @map("has_box")
  hasPapers      Boolean @default(false) @map("has_papers")
  isOriginal     Boolean @default(true) @map("is_original")

  auctionId Int     @unique @map("auction_id")
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  category WatchCategory

  wristwatch  Wristwatch?
  pocketWatch PocketWatch?
  smartwatch  Smartwatch?
  clock       Clock?
}

model Wristwatch {
  id          Int       @id @default(autoincrement())
  watchItemId Int       @unique @map("watch_item_id")
  watchItem   WatchItem @relation(fields: [watchItemId], references: [id], onDelete: Cascade)

  movementType    String @map("movement_type")
  caseDiameter    Int    @map("case_diameter")
  waterResistance String @map("water_resistance")
  strapMaterial   String @map("strap_material")
  glassType       String @map("glass_type")
}

model PocketWatch {
  id          Int       @id @default(autoincrement())
  watchItemId Int       @unique @map("watch_item_id")
  watchItem   WatchItem @relation(fields: [watchItemId], references: [id], onDelete: Cascade)

  caseType      String  @map("case_type")
  movementType  String  @map("movement_type")
  hasChain      Boolean @default(false) @map("has_chain")
  complications String?
}

model Smartwatch {
  id          Int       @id @default(autoincrement())
  watchItemId Int       @unique @map("watch_item_id")
  watchItem   WatchItem @relation(fields: [watchItemId], references: [id], onDelete: Cascade)

  os            String
  batteryLife   Int    @map("battery_life")
  screenType    String @map("screen_type")
  sensors       String
  compatibility String
}

model Clock {
  id          Int       @id @default(autoincrement())
  watchItemId Int       @unique @map("watch_item_id")
  watchItem   WatchItem @relation(fields: [watchItemId], references: [id], onDelete: Cascade)

  clockType   String  @map("clock_type")
  powerSource String  @map("power_source")
  chimeType   String? @map("chime_type")
  dimensions  String
}

model Trendings {
  id        Int     @id @default(autoincrement())
  auctionId Int     @unique @map("auction_id")
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  clicks    Int      @default(0)
  updatedAt DateTime @updatedAt
}
